
# hreflang e sitemap. Se ficar vazio, o endereço é deduzido do pedido.
SITE_URL=

# Origem dos serviços de medição que devolvem o local aproximado e o servidor de teste (ver .env).
VITE_ORIGEM_MEDICAO=

# Tradução automática (usada só por `npm run i18n` e pelo CI, nunca pela aplicação).
# Ponha estes valores em .env.local, que o Git ignora. Nunca no código.
# TRADUCAO_ENDPOINT=https://api.cloudflare.com/client/v4
# TRADUCAO_CONTA=identificador da conta
# TRADUCAO_TOKEN=token com permissão apenas de execução de modelos de IA
# TRADUCAO_MODELO=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# TRADUCAO_MODO_JSON=1

# Enderecos das redes sociais mostradas no rodape. Sem endereco, o icone nao aparece.
VITE_REDE_X=
VITE_REDE_FACEBOOK=
VITE_REDE_TIKTOK=
